<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingTop="32dp"
        android:paddingEnd="56dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/headlineDetail" style="@style/Body" android:textColor="@color/muted" />

        <Button
            android:id="@+id/playStore"
            style="@style/Action"
            android:text="@string/open_play_store"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/setupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/Section" android:text="@string/setup_title" />
            <TextView style="@style/Body" android:text="@string/setup_steps" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/pairPort"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/pair_port"
                    android:inputType="number" />

                <EditText
                    android:id="@+id/pairCode"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/pair_code"
                    android:inputType="number" />

                <Button android:id="@+id/pair" style="@style/Action" android:text="@string/pair" />
            </LinearLayout>

            <Button android:id="@+id/connect" style="@style/Action" android:text="@string/connect" />
            <TextView android:id="@+id/setupResult" style="@style/Body" android:textColor="@color/muted" />
        </LinearLayout>

        <TextView style="@style/Section" android:text="@string/section_youtube" />
        <TextView android:id="@+id/youtube" style="@style/Body" />

        <TextView style="@style/Section" android:text="@string/section_tizentube" />
        <TextView android:id="@+id/tizentube" style="@style/Body" />
        <TextView
            android:id="@+id/signatureNote"
            style="@style/Body"
            android:text="@string/signature_note"
            android:textColor="@color/bad"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/updateNow" style="@style/Action" android:text="@string/update_now" />
            <Button
                android:id="@+id/reinstall"
                style="@style/Action"
                android:text="@string/reinstall"
                android:visibility="gone" />
        </LinearLayout>

        <TextView style="@style/Section" android:text="@string/section_button" />
        <TextView android:id="@+id/button" style="@style/Body" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Switch android:id="@+id/takeOver" style="@style/Action" android:text="@string/take_over" />
            <Button android:id="@+id/learn" style="@style/Action" android:text="@string/learn" />
        </LinearLayout>

        <TextView style="@style/Section" android:text="@string/section_settings" />
        <Switch android:id="@+id/keepAdb" style="@style/Action" android:text="@string/keep_adb" />

        <TextView style="@style/Section" android:text="@string/section_log" />
        <TextView
            android:id="@+id/log"
            style="@style/Body"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button android:id="@+id/undo" style="@style/Action" android:text="@string/undo" />
            <Button android:id="@+id/uninstall" style="@style/Action" android:text="@string/uninstall_tizentube" />
            <Button android:id="@+id/appUpdate" style="@style/Action" android:text="@string/check_app_update" />
        </LinearLayout>

        <TextView android:id="@+id/about" style="@style/Body" android:textColor="@color/muted" />
    </LinearLayout>
</ScrollView>
